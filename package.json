{
  "name": "task-killer-electron",
  "version": "0.1.0",
  "author": "Saleheen",
  "private": true,
  "description": "Dark-mode-first Electron + React + Vite cross-platform task killer app scaffold",
  "type": "module",
  "main": "out/main/index.cjs",
  "build": {
    "appId": "com.task-killer.app",
    "productName": "Dtask",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "asarUnpack": [
      "resources/**"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "dtask-windows-setup"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "electron-builder --publish=never",
    "dist:win": "electron-builder --win --publish=never",
    "dist:mac": "electron-builder --mac --publish=never",
    "dist:linux": "electron-builder --linux --publish=never"
  },
  "dependencies": {
    "lucide-react": "^1.11.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^25.6.0",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "41.3.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "tailwindcss": "4",
    "typescript": "^6.0.3",
    "vite": "^6.0.0"
  }
}
